# Copy to .env and fill in from Supabase → Project settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server secrets are set with `npx supabase secrets set` (see README), not here.
# Public address of the web app, used in referral links shared from the app.
EXPO_PUBLIC_APP_URL=https://app.batinode.be
